# Copy to .env only if you want to override the defaults. Spacebot needs none of this:
# with Ollama running it finds the local model by itself, and with nothing running it
# falls back to an offline heuristic so the app still works.

# --- provider ---
# auto (default) = use local Ollama if it answers, else a hosted key, else offline
SPACEBOT_PROVIDER=auto            # auto | ollama | anthropic | openai | mock

# --- Ollama (local, free, the default) ---
OLLAMA_BASE_URL=http://localhost:11434
# SPACEBOT_COMPOSE_MODEL=llama3.2:3b
# SPACEBOT_ROUTE_MODEL=llama3.2:3b
# SPACEBOT_VISION_MODEL=llama3.2-vision

# --- hosted alternatives (optional) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# --- server ---
# SPACEBOT_PORT=8080
# SPACEBOT_DB=./data/spacebot.db

# All of this can also be set at runtime on the Model settings page — no restart needed.
