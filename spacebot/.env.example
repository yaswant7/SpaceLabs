# Copy to .env to use a real model. With NO key set, Spacebot runs in mock mode
# (offline heuristic) so the whole POC still works — just with simpler answers.

# --- pick one provider (or leave as auto) ---
SPACEBOT_PROVIDER=auto            # auto | anthropic | openai | mock

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=

# --- OpenAI or any OpenAI-compatible endpoint (Azure, local Ollama, etc.) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# --- optional model overrides ---
# SPACEBOT_ROUTE_MODEL=
# SPACEBOT_COMPOSE_MODEL=
# SPACEBOT_VISION_MODEL=

# You can also set all of this at runtime on the /admin page — no restart needed.
